# Port & Environment
PORT=3000
NODE_ENV=production

# Google Gemini API (Multimodal text analysis & image moderation)
# Dapatkan dari: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Safe Browsing API v4 (Optional URL reputation)
SAFE_BROWSING_API_KEY=your_safe_browsing_key_here

# Primary Admin Contact Phone for Private WhatsApp Alert Dispatch
PRIMARY_ADMIN_PHONE=+6281223344550

# WhatsApp Cloud API Webhook Verify Token (If using Meta Cloud API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=srj_guardian_verify_token_2026

# Supabase PostgreSQL Configuration (Optional: automatically falls back to persistent internal store)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
